{
    "name": "mini-keno-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "author": "",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "integration-test": "jest tests/integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --forceExit",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "stats": "nodemon --es-module-specifier-resolution=node --watch ./tests ./tests/result-statistic.js"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "d3-array": "3.2.0",
        "lodash": "4.17.21",
        "random-js": "2.1.0",
        "sc-multiple-games-base": "2.0.0",
        "sc-rebet-mode": "1.0.0"
    },
    "resolutions": {
        "sc-game-base": "4.1.0",
        "sc-base-apis": "1.18.2",
        "sc-base-database": "1.11.1",
        "mongoose": "5.13.20"
    },
    "devDependencies": {
        "@babel/core": "7.24.5",
        "@babel/preset-env": "7.24.5",
        "@commitlint/cli": "20.2.0",
        "@commitlint/config-conventional": "9.1.2",
        "@types/jest": "26.0.24",
        "babel-jest": "26.6.3",
        "husky": "4.3.8",
        "install": "0.13.0",
        "jest": "26.6.3",
        "jest-auto-fixture": "1.0.6",
        "jest-extended": "0.11.5",
        "jest-html-reporters": "3.1.7",
        "jest-junit": "12.3.0",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "2.0.0",
        "nodemon": "2.0.22",
        "sc-game-service-integration-utils": "1.3.5"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "jest": {
        "testResultsProcessor": "jest-junit"
    }
}
